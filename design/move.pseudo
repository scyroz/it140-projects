# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7

START move_between_rooms

    # TODO 1: Identify required data structures and starting state
    DECLARE rooms AS DICTIONARY = {
        'Great Hall': {'North': 'Dungeon', 'South': 'Bedroom', 'East': 'Kitchen', 'West': 'Library'},
        'Dungeon': {'South': 'Great Hall', 'East': 'Gallery'},
        'Gallery': {'West': 'Dungeon'},
        'Library': {'East': 'Great Hall'},
        'Kitchen': {'West': 'Great Hall', 'North': 'Dining Room'},
        'Dining Room': {'South': 'Kitchen'},
        'Bedroom': {'North': 'Great Hall', 'East': 'Cellar'},
        'Cellar': {'West': 'Bedroom'}
    }
    DECLARE current_room AS STRING = 'Great Hall'
    DECLARE inventory AS LIST = []

    # TODO 6: Repeated gameplay loop
    WHILE TRUE
        OUTPUT "You are in the " + current_room
        OUTPUT "Inventory: " + inventory

        # TODO 2: Prompt for and receive user movement command
        INPUT player_command "Enter your move:"
        SET command_parts = SPLIT(TRIM(player_command), " ")

        IF LENGTH(command_parts) != 2 THEN
            OUTPUT "Invalid Input!"
        ELSE
            SET action = LOWERCASE(command_parts[0])
            SET direction = CAPITALIZE(command_parts[1])

            IF action EQUALS "go" THEN
                # TODO 3: Validate requested movement
                IF direction IN rooms[current_room] THEN
                    # TODO 4: Valid move handling
                    SET current_room = rooms[current_room][direction]
                ELSE
                    # TODO 5: Invalid move output
                    OUTPUT "You can't go that way!"
                END IF
            ELSE
                OUTPUT "Invalid Input!"
            END IF
        END IF

    END WHILE

END move_between_rooms
